# Agent OS Protocol — environment configuration
# Copy to `.env` and adjust. All values are optional; sensible local-mode
# defaults apply when unset. Secrets stay local and are never sent to a lobby.

# ── Lobby ──
# Remote lobby URL for Swarm Mode. Leave EMPTY for Local Mode (built-in local lobby).
AGENT_OS_LOBBY_URL=

# ── Ports ──
AGENT_OS_PANEL_PORT=4800
AGENT_OS_RELAY_PORT=4722

# ── Runtime ──
# Default agent runtime adapter (claude-cli is first-class; others added per roadmap).
AGENT_OS_RUNTIME=claude-cli

# ── Model providers (API fuel) — BYOK, stored locally, never sent to a lobby ──
# Only needed when fueling agents directly via an API instead of a CLI runtime.
# The platform stores only the env-var NAME; the key value stays in your environment.
#
# Default provider when an agent does not pin one (openai-compatible | anthropic-compatible):
# AGENT_OS_PROVIDER=openai-compatible
#
# OpenAI-compatible (OpenAI, OpenRouter, Together, vLLM, LM Studio, Ollama's OpenAI shim, …):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Anthropic-compatible:
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Agent identity (Phase 8) — read-only verification, no keys ──
# Base URL of a Concordium Agent Registry indexer (read API). When set, the lobby server can
# verify presented identity references and enforce a `registered` / `verified_human_link` join
# policy. Leave EMPTY to run without identity verification (such policies then fail closed).
# This is a READ-ONLY endpoint — Agent OS never stores or transmits a private key or wallet seed.
AGENT_OS_CONCORDIUM_INDEXER_URL=
