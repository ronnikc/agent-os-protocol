# Agent OS Protocol — environment configuration
# Copy to `.env` and adjust. All values are optional; sensible local-mode defaults apply when
# unset. The repo-root `.env` is loaded automatically by the panel, relay, and lobby servers.
#
# Precedence (highest first): explicit CLI flag (e.g. `--port`) → this `.env` / the environment
# → built-in default. The real environment always wins over `.env`. Secrets stay local — `.env`
# is gitignored and no value here is ever sent to a lobby.

# ── Lobby ──
# Remote lobby URL for Swarm Mode (read by the panel and the relay). Leave EMPTY for Local Mode
# (built-in local lobby). Equivalent to `--lobby <url>`, which overrides this.
AGENT_OS_LOBBY_URL=

# ── Ports ──
# Panel server port (default 4800). Equivalent to `--port`, which overrides this.
AGENT_OS_PANEL_PORT=4800
# Relay WebSocket port (default 4722). Equivalent to `--port` on `npm run relay`.
AGENT_OS_RELAY_PORT=4722
# Standalone lobby server port (default 4730), used by `npm run lobby`. `--port` overrides this.
AGENT_OS_LOBBY_PORT=4730
# Absolute path to the lobby's durable-state file (lobbies, provider keys, tasks, requests, KB,
# integrations). MUST point at storage that survives redeploys (a mounted volume) on a hosted
# deployment — otherwise all of that state is lost when the container is replaced. Empty = a
# per-container file in the working directory (local dev only; not durable across deploys).
AGENT_OS_LOBBY_STORE_FILE=

# Wallet identity allowed to claim an unowned production lobby (did:ccd:<network>:<account>).
# Existing owned lobbies and new lobbies created by signed-in wallets use their recorded owner.
AGENT_OS_PUBLIC_LOBBY_OWNER=

# Set on the local Panel/relay only when you trust the remote lobby to trigger local runtime turns.
AGENT_OS_ALLOW_REMOTE_EXECUTION=0
# Optional explicit lobby for a relay. Keep the lobby-scoped session token secret.
AGENT_OS_LOBBY_ID=
AGENT_OS_LOBBY_SESSION_TOKEN=

# Local/staging only. SHA-256 hex digest of a randomly generated 32-byte test admin key.
# Leave empty to disable wallet-free sign-in. Keep the original key outside the repository.
AGENT_OS_TEST_ADMIN_KEY_SHA256=

# ── Runtime (planned) ──
# Default agent runtime adapter. NOT yet wired into the relay's turn loop — the relay currently
# drives the Claude CLI (claude-cli) directly; routing it through the adapter is a tracked
# follow-up (see agent-os/STATE.md). Adapter SELECTION/detection already works in the panel
# (`GET /api/runtimes`); this variable is reserved for when the relay honours it.
# AGENT_OS_RUNTIME=claude-cli

# ── Model providers (API fuel) — BYOK, stored locally, never sent to a lobby ──
# Only needed when fueling agents directly via an API instead of a CLI runtime.
# The platform stores only the env-var NAME; the key value stays in your environment.
#
# Default provider when an agent does not pin one (openai-compatible | anthropic-compatible):
# AGENT_OS_PROVIDER=openai-compatible
#
# OpenAI-compatible (OpenAI, OpenRouter, Together, vLLM, LM Studio, Ollama's OpenAI shim, …):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Anthropic-compatible:
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Agent identity (Phase 8) — read-only verification, no keys ──
# Base URL of a Concordium Agent Registry indexer (read API), read by the lobby server. When set,
# the lobby can verify presented identity references and enforce a `registered` /
# `verified_human_link` join policy. Leave EMPTY to run without identity verification (such
# policies then fail closed). This is a READ-ONLY endpoint — Agent OS never stores or transmits a
# private key or wallet seed.
AGENT_OS_CONCORDIUM_INDEXER_URL=

# MCP endpoint of the Concordium Agent Registry service, read by the lobby server. When set, the
# lobby dashboard can anchor issued Agent Cards on-chain: the service builds a sign-ready
# register payload ({ hex, schema_json }) and the OWNER'S WALLET signs and submits the mint —
# the lobby and the MCP service hold no keys. Use the Concordium-hosted endpoint, or run it
# locally: docker run -e MCP_NETWORK=mainnet -p 3000:3000 concordium/agent-registry-mcp:latest
# → http://localhost:3000/mcp. Leave EMPTY for off-chain mode (wallet-signed, lobby-hosted cards).
# https://docs.concordium.com/en/mainnet/technical-reference/agent-registry/mcp-service.html
AGENT_OS_AGENT_REGISTRY_MCP_URL=

# Concordium sponsor service endpoint — makes Agent-ID minting GASLESS (Concordium pays the energy
# instead of the owner's wallet). Only used when the registry MCP service above is also set. The
# lobby relays the wallet-built UNSIGNED transaction to the sponsor and returns the partially-signed
# transaction for the wallet to complete and submit — no keys pass through the lobby. Defaults to the
# Concordium-hosted endpoint when unset; set to empty to force the self-paid submission path.
# https://registry-sponsor-service.concordium.com/sponsor
AGENT_OS_REGISTRY_SPONSOR_URL=https://registry-sponsor-service.concordium.com/sponsor

# ── Hosted Mode (multi-tenant, server-side) — see docs/hosted-panel.md ──
# Master key used to encrypt at-rest server-side secrets (hosted provider API keys, integration
# tokens) with AES-256-GCM. REQUIRED for Hosted Mode; Local Mode never stores keys server-side and
# does not need it. Generate a strong random value (e.g. `openssl rand -hex 32`) and keep it out of
# source control. Rotating it: set a new AGENT_OS_SECRET_KEY_ID and re-save affected keys.
AGENT_OS_SECRET_ENCRYPTION_KEY=
AGENT_OS_SECRET_KEY_ID=v1

# Concordium gRPC nodes used to fetch FRESH account credentials during production wallet sign-in
# (verifies the signMessage signature against the account's current on-chain keys). Defaults to the
# public nodes below when unset. Format: host:port.
AGENT_OS_CONCORDIUM_NODE_MAINNET=grpc.mainnet.concordium.software:20000
AGENT_OS_CONCORDIUM_NODE_TESTNET=grpc.testnet.concordium.com:20000

# ── GitHub App (Hosted Mode) — connect the user's OWN repo so hosted agents can read it and land
# changes as commits/PRs. Register ONE GitHub App (Settings → Developer settings → GitHub Apps) with
# repository permissions Contents: Read & write and Pull requests: Read & write, set its callback to
# https://<your-lobby-host>/api/v1/agent-lobby/integrations/github/callback, then set these. The lobby
# holds only short-lived, encrypted installation tokens — never a repo or a user password. Leave unset
# to disable GitHub connect.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The App's PEM private key. Either paste literal newlines, or a single line with \n escapes.
GITHUB_APP_PRIVATE_KEY=
# Master key + id used to encrypt stored integration secrets (installation tokens) at rest.
INTEGRATION_SECRET_KEY=
INTEGRATION_KEY_ID=v1

# DEV ONLY — accept wallet login signatures without cryptographic verification (legacy /auth/verify
# path only; the production /auth/verify-wallet path always verifies on-chain). Lets the panel be
# demoed on testnet without a reachable node. OFF by default, and the server REFUSES TO START if it
# is set while NODE_ENV/AGENT_OS_ENV=production. Never set this in production.
AGENT_OS_DEV_TRUST_WALLET_SIGNATURES=
