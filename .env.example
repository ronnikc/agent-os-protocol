# Agent OS Protocol — environment configuration
# Copy to `.env` and adjust. All values are optional; sensible local-mode defaults apply when
# unset. The repo-root `.env` is loaded automatically by the panel, relay, and lobby servers.
#
# Precedence (highest first): explicit CLI flag (e.g. `--port`) → this `.env` / the environment
# → built-in default. The real environment always wins over `.env`. Secrets stay local — `.env`
# is gitignored and no value here is ever sent to a lobby.

# ── Lobby ──
# Remote lobby URL for Swarm Mode (read by the panel and the relay). Leave EMPTY for Local Mode
# (built-in local lobby). Equivalent to `--lobby <url>`, which overrides this.
AGENT_OS_LOBBY_URL=

# ── Ports ──
# Panel server port (default 4800). Equivalent to `--port`, which overrides this.
AGENT_OS_PANEL_PORT=4800
# Relay WebSocket port (default 4722). Equivalent to `--port` on `npm run relay`.
AGENT_OS_RELAY_PORT=4722
# Standalone lobby server port (default 4730), used by `npm run lobby`. `--port` overrides this.
AGENT_OS_LOBBY_PORT=4730

# ── Runtime (planned) ──
# Default agent runtime adapter. NOT yet wired into the relay's turn loop — the relay currently
# drives the Claude CLI (claude-cli) directly; routing it through the adapter is a tracked
# follow-up (see agent-os/STATE.md). Adapter SELECTION/detection already works in the panel
# (`GET /api/runtimes`); this variable is reserved for when the relay honours it.
# AGENT_OS_RUNTIME=claude-cli

# ── Model providers (API fuel) — BYOK, stored locally, never sent to a lobby ──
# Only needed when fueling agents directly via an API instead of a CLI runtime.
# The platform stores only the env-var NAME; the key value stays in your environment.
#
# Default provider when an agent does not pin one (openai-compatible | anthropic-compatible):
# AGENT_OS_PROVIDER=openai-compatible
#
# OpenAI-compatible (OpenAI, OpenRouter, Together, vLLM, LM Studio, Ollama's OpenAI shim, …):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Anthropic-compatible:
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Agent identity (Phase 8) — read-only verification, no keys ──
# Base URL of a Concordium Agent Registry indexer (read API), read by the lobby server. When set,
# the lobby can verify presented identity references and enforce a `registered` /
# `verified_human_link` join policy. Leave EMPTY to run without identity verification (such
# policies then fail closed). This is a READ-ONLY endpoint — Agent OS never stores or transmits a
# private key or wallet seed.
AGENT_OS_CONCORDIUM_INDEXER_URL=
