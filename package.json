{
  "name": "agent-os-protocol",
  "version": "0.2.0",
  "private": true,
  "description": "An open, runtime-agnostic operating system for agentic software development — orchestrate specialized AI agents locally or across an accountable remote swarm.",
  "license": "Apache-2.0",
  "author": "Gothard.dk // Ronni K. Gothard Christiansen (https://gothard.dk)",
  "homepage": "https://github.com/ronnikc/agent-os-protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronnikc/agent-os-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/ronnikc/agent-os-protocol/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agents",
    "ai",
    "orchestration",
    "claude",
    "agentic",
    "multi-agent",
    "swarm",
    "developer-tools"
  ],
  "scripts": {
    "agent-os-panel": "tsx agent-os/scripts/agent-os-panel-server.ts",
    "website": "tsx apps/website/server.ts",
    "agent-os-panel-tray": "tsx agent-os/scripts/agent-os-panel-tray.ts",
    "relay": "tsx packages/relay/src/relay-server.ts",
    "lobby": "tsx packages/lobby-server/src/server.ts",
    "lobby-web": "tsx packages/lobby-server/src/server.ts",
    "train": "node agent-os/scripts/train.mjs",
    "self-learning-review": "node agent-os/scripts/self-learning-review.mjs",
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "prepare": "node scripts/setup-hooks.mjs",
    "work-items": "tsx agent-os/scripts/work-items.ts",
    "loop": "tsx agent-os/scripts/loop.ts",
    "ui-assist-integrate": "tsx agent-os/scripts/ui-assist-integrate.ts",
    "prepare-agent-card": "tsx agent-os/scripts/prepare-agent-card.ts",
    "prepare-registration": "tsx agent-os/scripts/prepare-registration.ts",
    "verify-adapters": "tsx agent-os/scripts/verify-adapters.ts",
    "verify-providers": "tsx agent-os/scripts/verify-providers.ts",
    "verify-lobby": "tsx agent-os/scripts/verify-lobby.ts",
    "verify-identity": "tsx agent-os/scripts/verify-identity.ts",
    "verify-ui-assist": "tsx agent-os/scripts/verify-ui-assist.ts",
    "verify-loop": "tsx agent-os/scripts/verify-loop.ts",
    "verify-ui": "tsx agent-os/scripts/verify-ui.ts",
    "verify-launch": "tsx agent-os/scripts/verify-launch.ts",
    "verify-memory": "tsx agent-os/scripts/verify-memory.ts",
    "verify-all": "npm run verify-adapters && npm run verify-providers && npm run verify-lobby && npm run verify-identity && npm run verify-ui-assist && npm run verify-loop && npm run verify-ui && npm run verify-launch && npm run verify-memory",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/protocol-core",
    "packages/adapters",
    "packages/providers",
    "packages/lobby-server",
    "packages/lobby-client",
    "packages/identity-concordium",
    "packages/ui-assist-core",
    "packages/loop",
    "packages/relay",
    "packages/knowledge-engine",
    "packages/slack-relay",
    "packages/registry-identity"
  ]
}
